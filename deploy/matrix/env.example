# gnubook Matrix-Bot – Konfiguration
# Wird von deploy/install-matrix.sh nach /opt/gnubook/matrix/gnubook-matrix.env kopiert (Rechte 600, gnubook).
# Kommentare in eigenen Zeilen.

# --- Pflicht ---
GNUBOOK_MATRIX_HOMESERVER=https://matrix.example.org
# Muss identisch mit [matrix] bot_mxid in /opt/gnubook/config.toml sein
GNUBOOK_MATRIX_USER=@gnubookbot:example.org
# Nur beim ERSTEN Start nötig – danach wird ein Access-Token gespeichert und das
# Passwort sollte wieder entfernt werden.
GNUBOOK_MATRIX_PASSWORD=BitteHierDasBotPasswort

# --- Pfade (Standardwerte passen zu gnubook) ---
# Spool-Verzeichnis von gnubook (data_dir/matrix mit inbox/ und outbox/)
GNUBOOK_MATRIX_SPOOL_DIR=/opt/gnubook/data/matrix
# E2EE-Schlüsselspeicher (unbedingt sichern!)
GNUBOOK_MATRIX_STORE=/opt/gnubook/matrix-store

# --- Verhalten (optional) ---
# 1 = Nachrichten (Login-Links!) nur in E2E-verschlüsselte Chats senden (empfohlen).
# Element & Co. verschlüsseln neue Direktnachrichten standardmäßig.
GNUBOOK_MATRIX_REQUIRE_ENCRYPTION=1
# Long-Poll je Sync in ms (bestimmt die Reaktionszeit)
GNUBOOK_MATRIX_SYNC_TIMEOUT_MS=10000
# Nachrichten älter als X Sekunden ignorieren
GNUBOOK_MATRIX_MAX_EVENT_AGE=1800
# Ungesendete Nachrichten nach X Sekunden verwerfen
GNUBOOK_MATRIX_OUTBOX_TTL=900
GNUBOOK_MATRIX_DEVICE_NAME=gnubook-Bot
