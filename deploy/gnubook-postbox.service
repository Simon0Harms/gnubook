[Unit]
Description=gnubook – fetch documents from the broker's postbox (Belegeingang, scheduled)
After=network-online.target gnubook-ppcore.service
Wants=network-online.target

[Service]
Type=oneshot
User=gnubook
Group=gnubook
Environment=GNUBOOK_CONFIG=/opt/gnubook/config.toml
ExecStart=/opt/gnubook/venv/bin/gnubook postbox-fetch --scheduled
# a first run with a long backlog lists and downloads hundreds of documents
TimeoutStartSec=12h
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/gnubook/data
